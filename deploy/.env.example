# This entire file is stored as the PRODUCTION_ENV GitHub Environment secret.
GHCR_OWNER=your-github-user

POSTGRES_DB=StoreDb
POSTGRES_USER=store
# Use hex-only random secrets so dotenv and connection-string parsing stay unambiguous.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters

MINIO_ROOT_USER=store-minio
MINIO_ROOT_PASSWORD=replace-with-64-random-hex-characters
MINIO_BUCKET=store

JWT_KEY=replace-with-64-random-hex-characters
JWT_ISSUER=Store
JWT_AUDIENCE=StoreClient
JWT_EXPIRE_MINUTES=1440

SERVER_PUBLIC_HOST=203.0.113.10
WEBSITE_PORT=3000
PANEL_PORT=3001
API_PORT=8080
MINIO_PORT=9000
